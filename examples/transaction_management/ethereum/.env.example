TURNKEY_API_PRIVATE_KEY='YOUR_API_PRIVATE_KEY'
TURNKEY_ORGANIZATION_ID='YOUR_ORGANIZATION_ID'
TURNKEY_SIGN_WITH='YOUR_WALLET_ADDRESS'
# Optional. CAIP-2 chain ID. Defaults to Ethereum Sepolia testnet (eip155:11155111).
# Note: the swap action's contract addresses are Ethereum Sepolia-only.
# TURNKEY_CAIP2='eip155:11155111'
# Optional. One of: send (default), swap, assets.
# ACTION='send'
# Optional. Set to 'false' for non-sponsored mode (the EOA pays gas).
# SPONSOR='true'
